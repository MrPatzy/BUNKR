# BUNKR port 8765: only this machine, your reverse proxy or tunnel connector, and listed home devices.
# BUNKR requires a login; these addresses can reach the login page. Reserve these IPs in your router,
# and replace the examples below with your own.
table inet bunkr
delete table inet bunkr
table inet bunkr {
	set allowed4 {
		type ipv4_addr
		elements = {
			192.168.1.5,    # example: tunnel connector or reverse proxy
			192.168.1.20,   # example: main PC
		}
	}

	# Blocked sources from the last hour, to identify new devices: nft list set inet bunkr seen4
	set seen4 { type ipv4_addr; flags dynamic,timeout; timeout 1h; }
	set seen6 { type ipv6_addr; flags dynamic,timeout; timeout 1h; }

	chain input {
		type filter hook input priority -10; policy accept;
		tcp dport 8765 iif "lo" accept
		tcp dport 8765 ip saddr @allowed4 counter accept
		tcp dport 8765 meta nfproto ipv4 add @seen4 { ip saddr }
		tcp dport 8765 meta nfproto ipv6 add @seen6 { ip6 saddr }
		tcp dport 8765 counter drop
	}
}
